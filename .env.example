# Turso (libSQL)
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN=""

# NextAuth
AUTH_SECRET=""               # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Beverage ERP"
DEFAULT_COUNTRY="TZ"
DEFAULT_CURRENCY="TZS"

# Admin bootstrap — visit /api/setup once after first deploy to create the admin account
ADMIN_EMAIL=""         # email of the first admin user
ADMIN_PASSWORD=""      # initial password (min 8 chars); only needed if the user doesn't exist yet
